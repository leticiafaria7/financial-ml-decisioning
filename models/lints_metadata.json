{
    "model_type": "Linear Thompson Sampling",
    "library": "mabwiser",
    "arms": [
        "cellular",
        "telephone"
    ],
    "baseline_arm": "cellular",
    "alpha": 0.1,
    "l2_lambda": 10.0,
    "seed": 42,
    "train_years": [
        2008,
        2009
    ],
    "test_year": 2010,
    "numeric_features": [
        "age",
        "previous",
        "emp_var_rate",
        "cons_price_idx",
        "cons_conf_idx",
        "euribor3m",
        "nr_employed"
    ],
    "categorical_features": [
        "job",
        "marital",
        "education",
        "housing",
        "loan",
        "month",
        "day_of_week",
        "poutcome"
    ],
    "context_features": [
        "age",
        "previous",
        "emp_var_rate",
        "cons_price_idx",
        "cons_conf_idx",
        "euribor3m",
        "nr_employed",
        "job",
        "marital",
        "education",
        "housing",
        "loan",
        "month",
        "day_of_week",
        "poutcome"
    ],
    "excluded_from_context": [
        "index",
        "year",
        "contact",
        "y",
        "faixa_etaria"
    ],
    "reward_definition": {
        "no": 0,
        "yes": 1
    },
    "offline_evaluation": "historical matching + model-based reward estimation",
    "causal_interpretation": false
}